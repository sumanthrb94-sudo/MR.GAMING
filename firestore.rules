rules_version = '2';

// MR. GAMING booking database.
// Public visitors may: read which slots are taken (no names) and open their own pass card by its link.
// Once signed in with their mobile number (SMS code) they may also book (a request carrying their uid and verified
// number, with the hold documents for the hours it needs), read their own bookings, and read the passes saved
// under that number.
// Signed in, they may also order food from /menu for delivery or pickup and read their own food orders.
// Settings/shop (shop location, delivery radius, tax details) and single bills by their link are public reads.
// Signed in, they keep a profile (users/{uid}: name, email, WhatsApp opt-in) that only they and the owners read.
// Everything else is owner-only.
// An owner is a signed-in user whose uid has a document in /admins (created with the admin key, never from the site).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isDate(d) { return d is string && d.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }
    function isOpenHour(h) { return h is int && h >= 11 && h <= 22; }   // starts 11 am to 10 pm; the room closes at 11 pm
    // Signed in with a mobile number verified by SMS code
    function isVerified() { return request.auth != null && request.auth.token.phone_number != null; }

    // A public hold: one console, one hour, tied to the caller's own request created in the same batch
    function validPublicHold(holdId) {
      let h = request.resource.data;
      return isVerified()
        && h.keys().hasOnly(['date', 'console', 'hour', 'requestId', 'status', 'createdAt'])
        && h.status in ['pending', 'booked']
        && h.console in ['ps5', 'xbox']
        && isOpenHour(h.hour)
        && isDate(h.date)
        && holdId == h.date + '_' + h.console + '_' + string(h.hour)
        && h.createdAt == request.time
        && h.requestId is string
        && existsAfter(/databases/$(database)/documents/requests/$(h.requestId))
        && getAfter(/databases/$(database)/documents/requests/$(h.requestId)).data.uid == request.auth.uid;
    }
    // An old-style unconfirmed ('pending') hold stops blocking the slot after 3 hours, so a request nobody confirmed
    // can be replaced. A 'booked' hold (website bookings now) never expires; only the owner frees it.
    function isStalePending() {
      return resource.data.status == 'pending' && request.time > resource.data.createdAt + duration.value(3, 'h');
    }

    match /holds/{holdId} {
      allow read: if true;
      allow create: if isAdmin() || validPublicHold(holdId);
      allow update: if isAdmin() || (isStalePending() && validPublicHold(holdId));
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      // The owner adds phone and walk-in bookings from /admin. Website bookings need a verified sign-in: uid is the
      // caller's and phone is the number the SMS code verified. They arrive as 'booked' ('pending' is the old,
      // pre-instant status, still read as such); the console marks them seen with ack/ackAt/ackBy, which only an owner can set.
      allow create: if isAdmin() || isVerified()
        && request.resource.data.keys().hasOnly(['id', 'uid', 'name', 'phone', 'date', 'start', 'hours', 'station', 'players', 'plan', 'game', 'food', 'total', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'phone'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.id == requestId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && isDate(request.resource.data.date)
        && isOpenHour(request.resource.data.start)
        && request.resource.data.hours in [1, 2, 3]
        && request.resource.data.start + request.resource.data.hours <= 23
        && request.resource.data.station in ['ps5', 'xbox', 'squad']
        && request.resource.data.players is int && request.resource.data.players >= 1 && request.resource.data.players <= 4
        && request.resource.data.plan in ['hourly', 'buy-pass', 'use-pass', 'member']
        && request.resource.data.game is string && request.resource.data.game.size() <= 30
        && request.resource.data.food is string && request.resource.data.food.size() <= 300
        && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 20000
        && request.resource.data.status in ['pending', 'booked']
        && request.resource.data.createdAt == request.time;
      // A signed-in customer reads their own bookings (My bookings on /pass lists them with where('uid', '==', uid));
      // everyone else's, with names, stays owner-only. Only the owner changes or cancels a booking.
      allow get, list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // A customer signed in with their mobile number (SMS code) can read the passes saved under that number
    function isPassHolder() {
      return request.auth != null && request.auth.token.phone_number != null
        && resource.data.phoneE164 == request.auth.token.phone_number;
    }

    match /passes/{passId} {
      allow read: if isAdmin() || isPassHolder();
      allow write: if isAdmin();
    }

    // What a pass holder sees at /pass?id=...: first name and hours or meals only, no phone.
    // Readable one at a time by its unguessable id, never listed.
    match /passCards/{passId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---- Customer profiles (users/{uid}): the welcome form after a first sign-in, and "Edit profile" (profile.js).
    // Full name, an optional email, the verified number and the WhatsApp opt-in. Only that customer writes their own,
    // with the number their SMS code verified; they and the owners read it; only owners list them (console > Customers).
    function validProfile() {
      let u = request.resource.data;
      return u.keys().hasOnly(['name', 'email', 'phone', 'waOptIn', 'createdAt', 'updatedAt'])
        && u.keys().hasAll(['name', 'email', 'phone', 'waOptIn', 'createdAt', 'updatedAt'])
        && u.name is string && u.name.size() > 0 && u.name.size() <= 40
        && (u.email == null || (u.email is string && u.email.size() <= 100 && u.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')))
        && u.phone == request.auth.token.phone_number
        && u.waOptIn is bool
        && u.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isVerified() && request.auth.uid == uid && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if isVerified() && request.auth.uid == uid && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Members' board (/pass after sign-in): threads with a photo, replies, and the leaderboard the owner keeps.
    // A member is anyone signed in with their mobile number. Posts carry a first name the member typed, never a phone.
    // Images live in Firestore: a small thumbnail on the post, the full picture in postImages/{postId} (no Storage bucket needed).
    function isMember() { return isVerified(); }
    function validPost() {
      let p = request.resource.data;
      return p.keys().hasOnly(['uid', 'first', 'text', 'thumb', 'hasImage', 'replies', 'hidden', 'createdAt'])
        && p.uid == request.auth.uid
        && p.first is string && p.first.size() > 0 && p.first.size() <= 20
        && p.text is string && p.text.size() <= 500
        && p.thumb is string && p.thumb.size() <= 60000          // data: URL of a JPEG thumbnail, up to ~320px, or ''
        && p.hasImage is bool
        && (p.text.size() > 0 || p.hasImage)
        && p.replies == 0 && p.hidden == false
        && p.createdAt == request.time;
    }
    match /posts/{postId} {
      // Members read what the owner hasn't hidden (list queries must filter hidden == false); the owner reads everything
      allow read: if isAdmin() || (isMember() && resource.data.hidden == false);
      allow create: if isMember() && validPost();
      // The owner hides/unhides; a member may only bump the reply count by one when they reply
      allow update: if isAdmin()
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies']) && request.resource.data.replies == resource.data.replies + 1);
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if isAdmin() || isMember();
        allow create: if isMember() && request.resource.data.keys().hasOnly(['uid', 'first', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 20
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }
    // The full-size picture for a post, opened on tap. One per post, written by the post's author.
    match /postImages/{postId} {
      allow get: if isAdmin() || isMember();
      allow list: if false;
      allow create: if isMember() && request.resource.data.keys().hasOnly(['uid', 'image'])
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid
        && request.resource.data.image is string && request.resource.data.image.size() <= 700000;   // data: URL of a JPEG, up to ~1200px
      allow update: if false;
      allow delete: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
    }
    // Leaderboard: gamer tag, game, wins and points, typed in by the owner (never made up by the site)
    match /leaderboard/{entryId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin();
    }

    // ---- MR. Sandwich stock (/stock): products, batches with an expiry date (first expiry, first out) and a log of moves.
    // Only owners and stock staff. A stock staff member is a signed-in user whose uid has a document in /stockStaff
    // (added by an owner or with the admin key); it opens /stock only, never bookings, requests or passes.
    function isStockStaff() {
      return request.auth != null && exists(/databases/$(database)/documents/stockStaff/$(request.auth.uid));
    }
    function canStock() { return isAdmin() || isStockStaff(); }
    function isQty(q) { return (q is int || q is float) && q >= 0 && q <= 100000; }
    // "who" on a batch or move is the phone number the person signed in with, so the log can't be signed as someone else
    function isMe(by) { return by is string && request.auth.token.phone_number != null && by == request.auth.token.phone_number; }
    function validProduct() {
      let p = request.resource.data;
      return p.keys().hasOnly(['name', 'unit', 'category', 'low', 'createdAt'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 60
        && p.unit is string && p.unit.size() > 0 && p.unit.size() <= 20
        && p.category is string && p.category.size() <= 30
        && isQty(p.low)
        && p.createdAt is timestamp;
    }

    match /stockStaff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /stockProducts/{productId} {
      allow read: if canStock();
      allow create: if canStock() && validProduct() && request.resource.data.createdAt == request.time;
      allow update: if canStock() && validProduct() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canStock();
    }

    // One delivery of a product with one expiry date (null = no expiry, e.g. plates). Using it only lowers qty;
    // a batch used up or thrown away is deleted.
    match /stockBatches/{batchId} {
      allow read: if canStock();
      allow create: if canStock()
        && request.resource.data.keys().hasOnly(['productId', 'qty', 'expiry', 'note', 'addedAt', 'addedBy'])
        && request.resource.data.productId is string
        && exists(/databases/$(database)/documents/stockProducts/$(request.resource.data.productId))
        && isQty(request.resource.data.qty) && request.resource.data.qty > 0
        && (request.resource.data.expiry == null || request.resource.data.expiry is timestamp)
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.addedAt == request.time
        && isMe(request.resource.data.addedBy);
      allow update: if canStock()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
        && isQty(request.resource.data.qty) && request.resource.data.qty < resource.data.qty;
      allow delete: if canStock();
    }

    // History: added / used / thrown away. Append-only from the site.
    match /stockMoves/{moveId} {
      allow read: if canStock();
      allow create: if canStock()
        && request.resource.data.keys().hasOnly(['productId', 'batchId', 'type', 'qty', 'at', 'by'])
        && request.resource.data.productId is string && request.resource.data.productId.size() <= 40
        && request.resource.data.batchId is string && request.resource.data.batchId.size() <= 40
        && request.resource.data.type in ['add', 'use', 'waste']
        && isQty(request.resource.data.qty) && request.resource.data.qty > 0
        && request.resource.data.at == request.time
        && isMe(request.resource.data.by);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // ---- MR. Sandwich menu changes for today, made from the console (/admin, Menu): a price that differs from the
    // printed menu, sold out today, or hidden. Doc id = slug of the item name ('paneer-pizza'; two-price items add
    // '-0' / '-1' per column). Everyone reads them (/menu, home and booking apply them); owners and stock staff write.
    match /menuOverrides/{itemId} {
      allow get, list: if true;
      allow create, update: if canStock()
        && itemId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && itemId.size() <= 80
        && request.resource.data.keys().hasOnly(['price', 'soldOut', 'hidden', 'updatedAt', 'by'])
        && (!('price' in request.resource.data) || (request.resource.data.price is int && request.resource.data.price >= 1 && request.resource.data.price <= 10000))
        && (!('soldOut' in request.resource.data) || request.resource.data.soldOut is bool)
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && request.resource.data.updatedAt == request.time
        && isMe(request.resource.data.by);
      allow delete: if canStock();
    }

    // ---- MR. Sandwich food orders from /menu: home delivery or pickup, paid on delivery / at pickup (cash or UPI).
    // A customer signed in with their mobile number creates one; it carries their uid and the verified number, the live
    // menu price of each line (the console flags any line that differs from the menu), a subtotal that must equal the sum of
    // the lines, status 'placed' and payment { method: 'cod', status: 'unpaid' } (a payment gateway later writes its own
    // method). Orders only while the shop is open (11 am to 11 pm India time, CONFIG.open/close in main.js), and delivery only
    // when the owner has set the shop location, left delivery on, and the drop is within the free radius (settings/shop).
    // The customer reads their own orders (My orders on /pass, tracking on /menu); the owner reads and moves them along.
    // The lines of an order are also written, in the same batch, as up to five "parts" of at most six lines
    // (foodOrders/{id}/parts/0..4, each { lines, sum }), because rules evaluate at most 1,000 expressions per document
    // and checking 30 lines in one document goes over. Each part checks its own lines; the order checks that its items
    // are exactly the parts put together and its subtotal is the sum of theirs.
    // One line { id, name, col, price, qty }: exactly five fields, all read below (a missing one fails), so no others;
    // id, name and column together at most 200 characters (adding them also requires strings); price 1 to 10,000;
    // quantity 1 to 20.
    function okLine(l) {
      return l.size() == 5
        && (l.id + l.name + l.col).size() <= 200
        && l.price is int && l.price > 0 && l.price <= 10000
        && l.qty is int && l.qty > 0 && l.qty <= 20;
    }
    function okPart(it, n) {
      return n >= 1 && n <= 6 && okLine(it[0])
        && (n < 2 || okLine(it[1])) && (n < 3 || okLine(it[2])) && (n < 4 || okLine(it[3])) && (n < 5 || okLine(it[4])) && (n < 6 || okLine(it[5]));
    }
    function partSum(it, n) {
      return it[0].price * it[0].qty + (n < 2 ? 0 : it[1].price * it[1].qty) + (n < 3 ? 0 : it[2].price * it[2].qty) + (n < 4 ? 0 : it[3].price * it[3].qty) + (n < 5 ? 0 : it[4].price * it[4].qty) + (n < 6 ? 0 : it[5].price * it[5].qty);
    }
    function part(orderId, k) { return getAfter(/databases/$(database)/documents/foodOrders/$(orderId)/parts/$(k)).data; }
    function parts1(o, a) { return o.items == a.lines && o.subtotal == a.sum; }
    function parts2(o, a, b) { return o.items == a.lines.concat(b.lines) && o.subtotal == a.sum + b.sum; }
    function parts3(o, a, b, c) { return o.items == a.lines.concat(b.lines.concat(c.lines)) && o.subtotal == a.sum + b.sum + c.sum; }
    function parts4(o, a, b, c, d) { return o.items == a.lines.concat(b.lines.concat(c.lines.concat(d.lines))) && o.subtotal == a.sum + b.sum + c.sum + d.sum; }
    function parts5(o, a, b, c, d, e) { return o.items == a.lines.concat(b.lines.concat(c.lines.concat(d.lines.concat(e.lines)))) && o.subtotal == a.sum + b.sum + c.sum + d.sum + e.sum; }
    function partsOk(o, orderId, n) {
      return n <= 6 ? parts1(o, part(orderId, '0'))
        : n <= 12 ? parts2(o, part(orderId, '0'), part(orderId, '1'))
        : n <= 18 ? parts3(o, part(orderId, '0'), part(orderId, '1'), part(orderId, '2'))
        : n <= 24 ? parts4(o, part(orderId, '0'), part(orderId, '1'), part(orderId, '2'), part(orderId, '3'))
        : parts5(o, part(orderId, '0'), part(orderId, '1'), part(orderId, '2'), part(orderId, '3'), part(orderId, '4'));
    }
    // 11:00 to 22:59 India time (UTC+5:30)
    function shopOpen() {
      let m = (request.time.hours() * 60 + request.time.minutes() + 330) % 1440;
      return m >= 11 * 60 && m < 23 * 60;
    }
    // Flat-earth distance from the shop (fine at a few km; cosLat is saved with the location), with 2% for rounding
    function inRadius(o) {
      let s = get(/databases/$(database)/documents/settings/shop).data;
      let dy = (o.lat - s.lat) * 111.32;
      let dx = (o.lng - s.lng) * 111.32 * s.cosLat;
      let r = s.freeRadiusKm * 1.02;
      return s.deliveryOn == true && s.lat is number && s.lng is number && s.cosLat is number
        && o.distanceKm <= s.freeRadiusKm && dx * dx + dy * dy <= r * r;
    }
    function validFoodOrder(o, orderId) {
      // Exactly 16 fields, every one of them read below (a missing one fails): id, uid, phone, name, items, subtotal, mode,
      // address, landmark, lat, lng, distanceKm, note, status, payment, createdAt
      return isVerified()
        && o.size() == 16
        && o.id == orderId && orderId.matches('^FO-[0-9]{4}-[0-9]{4}-[A-Z0-9]{4}$')
        && o.uid == request.auth.uid
        && o.phone == request.auth.token.phone_number
        && o.name is string && o.name.size() > 0 && o.name.size() <= 40
        && o.items is list && o.items.size() >= 1 && o.items.size() <= 30
        && o.subtotal is int && o.subtotal >= 1
        && partsOk(o, orderId, o.items.size())
        && o.note is string && o.note.size() <= 200
        && o.status == 'placed'
        && o.payment == { 'method': 'cod', 'status': 'unpaid' }
        && o.createdAt == request.time
        && shopOpen()
        && ((o.mode == 'pickup' && o.address == '' && o.landmark == '' && o.lat == null && o.lng == null && o.distanceKm == null)
          || (o.mode == 'delivery'
            && o.address is string && o.address.size() >= 5 && o.address.size() <= 200
            && o.landmark is string && o.landmark.size() <= 100
            && o.lat is number && o.lat >= -90 && o.lat <= 90 && o.lng is number && o.lng >= -180 && o.lng <= 180
            && o.distanceKm is number && o.distanceKm >= 0
            && inRadius(o)));
    }
    match /foodOrders/{orderId} {
      allow create: if validFoodOrder(request.resource.data, orderId);
      allow get, list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // The owner: accept / preparing / out for delivery or ready for pickup / delivered or picked up / cancelled (with a
      // reason), ack/ackAt/ackBy when seen, payment once billed, and the bill { id, no } (null again if that bill is voided)
      allow update: if isAdmin();
      allow delete: if false;

      // The parts (see okLine above): only with a new order of the caller's, in the same batch; never changed
      match /parts/{k} {
        allow create: if isVerified() && k in ['0', '1', '2', '3', '4']
          && !exists(/databases/$(database)/documents/foodOrders/$(orderId))
          && getAfter(/databases/$(database)/documents/foodOrders/$(orderId)).data.uid == request.auth.uid
          && request.resource.data.size() == 2
          && request.resource.data.lines is list
          && okPart(request.resource.data.lines, request.resource.data.lines.size())
          && request.resource.data.sum == partSum(request.resource.data.lines, request.resource.data.lines.size());
        allow get, list: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ---- Shop settings (console > Settings): the shop location and free-delivery radius, delivery on/off, and the tax
    // details. Public: /menu needs the location and radius, and bills print the GSTIN. Owner-only writes.
    function validShop(s) {
      return s.keys().hasOnly(['lat', 'lng', 'accuracy', 'cosLat', 'locatedAt', 'freeRadiusKm', 'deliveryOn', 'gstin', 'legalName', 'foodGst', 'gamingGst', 'pricesExclusive', 'updatedAt', 'by'])
        && (!('lat' in s) || s.lat == null || (s.lat is number && s.lat >= -90 && s.lat <= 90))
        && (!('lng' in s) || s.lng == null || (s.lng is number && s.lng >= -180 && s.lng <= 180))
        && (!('cosLat' in s) || s.cosLat == null || (s.cosLat is number && s.cosLat > 0 && s.cosLat <= 1))
        && s.freeRadiusKm is number && s.freeRadiusKm > 0 && s.freeRadiusKm <= 30
        && s.deliveryOn is bool
        && s.gstin is string && (s.gstin == '' || s.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$'))
        && s.legalName is string && s.legalName.size() <= 100
        && s.foodGst is number && s.foodGst >= 0 && s.foodGst <= 28
        && s.gamingGst is number && s.gamingGst >= 0 && s.gamingGst <= 28
        && s.pricesExclusive is bool
        && s.updatedAt == request.time && isMe(s.by);
    }
    match /settings/{id} {
      allow get: if id == 'shop';
      allow list: if false;
      allow create, update: if isAdmin() && id == 'shop' && validShop(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- Bills (console > Bill on a food order, booking, birthday, pass or meal plan). Numbered MS-<financial year>-0001
    // upwards: counters/bills-<FY> holds the last number and goes up by exactly one with each bill, in the same transaction.
    // A bill carries the customer's first name only (never a phone), its lines and totals, how it was paid and who billed it.
    // Anyone with the link reads one bill by its unguessable id (/bill?id=...); only the owner lists them (takings, CSV).
    // Bills never change, except that an owner may void one once, with a reason.
    match /counters/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && id.matches('^bills-20[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n', 'updatedAt']) && request.resource.data.n == 1;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['n', 'updatedAt']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
    match /bills/{billId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['no', 'seq', 'fy', 'kind', 'ref', 'first', 'mode', 'lines', 'subtotal', 'taxes', 'tax', 'roundOff', 'total', 'gst', 'method', 'paidAt', 'by', 'createdAt'])
        && request.resource.data.fy is string && request.resource.data.fy.matches('^20[0-9]{2}-[0-9]{2}$')
        && request.resource.data.seq is int
        && getAfter(/databases/$(database)/documents/counters/$('bills-' + request.resource.data.fy)).data.n == request.resource.data.seq
        && request.resource.data.no == 'MS-' + request.resource.data.fy + '-' + (request.resource.data.seq < 10 ? '000' : request.resource.data.seq < 100 ? '00' : request.resource.data.seq < 1000 ? '0' : '') + string(request.resource.data.seq)
        && request.resource.data.kind in ['food', 'gaming', 'birthday', 'pass', 'meals']
        && request.resource.data.first is string && request.resource.data.first.size() <= 20
        && request.resource.data.lines is list && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 40
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.method in ['cash', 'upi', 'card']
        && request.resource.data.paidAt == request.time && request.resource.data.createdAt == request.time
        && isMe(request.resource.data.by);
      allow update: if isAdmin() && !('void' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['void'])
        && request.resource.data.void.keys().hasOnly(['reason', 'at', 'by'])
        && request.resource.data.void.reason is string && request.resource.data.void.reason.size() > 0 && request.resource.data.void.reason.size() <= 200
        && request.resource.data.void.at == request.time && isMe(request.resource.data.void.by);
      allow delete: if false;
    }
  }
}
